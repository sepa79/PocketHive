{
  "name": "pockethive-vscode",
  "displayName": "PocketHive",
  "description": "Connect to PocketHive MCP environments and operate swarms, scenarios, journals, and diagnostics.",
  "version": "1.0.6",
  "publisher": "pockethive",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/sepa79/PocketHive.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:pockethive.companion"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pockethive",
          "title": "PocketHive",
          "icon": "resources/activity-mark.svg"
        }
      ]
    },
    "views": {
      "pockethive": [
        {
          "type": "webview",
          "id": "pockethive.companion",
          "name": "PocketHive"
        }
      ]
    }
  },
  "scripts": {
    "assets:generate": "npm run assets:logo && npm run assets:icons",
    "assets:check": "npm run assets:logo:check && npm run assets:icons:check",
    "assets:logo": "node scripts/generate-logo-assets.mjs",
    "assets:logo:check": "node scripts/generate-logo-assets.mjs --check",
    "assets:icons": "node scripts/sync-codicons.mjs",
    "assets:icons:check": "node scripts/sync-codicons.mjs --check",
    "build": "node scripts/clean-output.mjs && npm run assets:generate && tsc -p ./",
    "build:mutation": "node scripts/clean-output.mjs && node node_modules/typescript/bin/tsc -p ./",
    "test:unit": "npm run build && node scripts/run-tests.mjs",
    "test": "npm run test:unit && npm run assets:check && node scripts/check-cutover.mjs",
    "watch": "tsc -watch -p ./",
    "package:check": "node scripts/check-package-files.mjs",
    "package": "npm test && npm run package:check && vsce package",
    "ui:check": "npm run build && node scripts/playwright-ui-check.mjs",
    "mutation": "stryker run",
    "vscode:prepublish": "npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "20.19.17",
    "@types/vscode": "1.85.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "3.9.2",
    "playwright": "1.60.0",
    "typescript": "5.9.2"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2",
    "markdown-it": "14.2.0",
    "playwright-core": "1.60.0",
    "qs": "6.15.3",
    "tmp": "0.2.7"
  }
}
