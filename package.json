{
  "name": "pockethive",
  "version": "0.15.35",
  "private": true,
  "description": "Development tooling for PocketHive",
  "scripts": {
    "build": "echo \"no build step\"",
    "contracts:generate": "node scripts/generate-swarm-lifecycle-contract.mjs && node scripts/generate-scenario-config-defaults.mjs",
    "contracts:check": "node scripts/generate-swarm-lifecycle-contract.mjs --check && node scripts/generate-scenario-config-defaults.mjs --check",
    "docs:impact": "node tools/docs-impact/cli.mjs",
    "review:completed-work": "node tools/completed-work-review/cli.mjs assemble",
    "review:completed-work:verify": "node tools/completed-work-review/cli.mjs verify",
    "lint": "npm run lint --prefix ui-v2",
    "mcp:agentic-evals": "npm run acceptance:agentic --prefix tools/pockethive-mcp",
    "mcp:doctor": "npm --prefix tools/pockethive-mcp run doctor --",
    "mcp:setup": "npm ci --prefix tools/pockethive-mcp",
    "mcp:start": "node tools/pockethive-mcp/start.cjs",
    "mcp:start:http": "npm --prefix tools/pockethive-mcp run start:http",
    "mcp:test": "npm test --prefix tools/pockethive-mcp",
    "mcp:workflow-acceptance": "npm run acceptance:workflow --prefix tools/pockethive-mcp",
    "test": "vitest run --passWithNoTests",
    "test:completed-work-review": "node --test tools/completed-work-review/*.test.mjs",
    "test:docs": "node tools/docs-validation/run.mjs --profile local --repo . --report .test-results/docs-validation/local.json --candidate-mode DIRTY_WORKTREE",
    "test:docs-impact": "node --test tools/docs-impact/*.test.mjs",
    "test:docs-validation": "node --test tools/docs-validation/*.test.mjs",
    "test:docs:all": "node tools/docs-validation/run.mjs --profile all --repo . --report .test-results/docs-validation/all.json --candidate-mode DIRTY_WORKTREE",
    "test:docs:deployed": "node tools/docs-validation/run.mjs --profile deployed --repo . --report .test-results/docs-validation/deployed.json --candidate-mode DIRTY_WORKTREE",
    "test:docs:packaging": "node tools/docs-validation/run.mjs --profile packaging --repo . --report .test-results/docs-validation/packaging.json --candidate-mode DIRTY_WORKTREE",
    "test:docs:runtime": "node tools/docs-validation/run.mjs --profile runtime --repo . --report .test-results/docs-validation/runtime.json --candidate-mode DIRTY_WORKTREE",
    "test:docs:setup": "node tools/docs-validation/run.mjs --profile setup --repo . --report .test-results/docs-validation/setup.json --candidate-mode DIRTY_WORKTREE",
    "test:docs:static": "node tools/docs-validation/run.mjs --profile static --repo . --report .test-results/docs-validation/static.json --candidate-mode DIRTY_WORKTREE"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "amqplib": "^0.10.4",
    "yaml": "^2.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@stomp/stompjs": "^7.0.0",
    "@testing-library/jest-dom": "^6.5.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@xyflow/react": "^12.3.3",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "saxes": "^6.0.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^4.1.8",
    "zustand": "^4.5.2"
  },
  "license": "GPL-3.0-or-later"
}
