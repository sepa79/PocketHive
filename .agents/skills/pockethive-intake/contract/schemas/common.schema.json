        },
        "generator": {
          "$ref": "#/definitions/text"
        },
        "scope": {
          "$ref": "#/definitions/text"
        },
        "correlationRef": {
          "$ref": "#/definitions/text",
          "description": "Correlation ID resolved within each destination occurrence of this API; extraction is authored only on that sequence step."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "correlation"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entityRef": {"type": "null"},
              "column": {"type": "null"},
              "value": {"type": "null"},
              "generator": {"type": "null"},
              "scope": {"type": "null"}
            }
          },
          "else": {
            "if": {"properties": {"type": {"enum": ["dataset", "constant", "generated"]}}, "required": ["type"]},
            "then": {"properties": {"correlationRef": {"type": "null"}}}
          }
        }
      ]
    },
