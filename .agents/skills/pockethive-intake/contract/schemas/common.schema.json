{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared PocketHive intake document shapes",
  "$comment": "Canonical shared shapes for draft intake documents. No default keywords, remote refs or runtime scenario validation.",
  "definitions": {
    "text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Unknown draft value is null; applicability/readiness is checked by the semantic intake owner."
    },
    "boolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "number": {
      "type": [
        "number",
        "null"
      ]
    },
    "nonnegativeNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "positiveCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "percentile": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "pointer": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:/(?:[^~]|~[01])*)?(?![\\s\\S])",
      "description": "RFC 6901 JSON Pointer with valid escapes; exact target resolution is checked semantically."
    },
    "jsonValue": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "description": "Opaque sample, observation or blueprint content. The canonical YAML codec bounds nested content; this shape does not validate its domain semantics."
    },
    "textList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "flexibleList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/jsonValue"
      }
    },
    "status": {
      "enum": [
        "pending",
        "blocked",
        "not-run",
        "pass",
        "fail",
        "inconclusive",
        "not-applicable",
        null
      ]
    },
    "documentTarget": {
      "type": "object",
      "properties": {
        "document": {
          "enum": [
            "requirements",
            "plan",
            "results",
            null
          ]
        },
        "pointer": {
          "$ref": "#/definitions/pointer"
        }
      },
      "additionalProperties": false,
      "required": [
        "document",
        "pointer"
      ]
    },
